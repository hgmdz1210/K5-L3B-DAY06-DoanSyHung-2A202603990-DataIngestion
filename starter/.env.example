# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# This project uses OpenAI; src/embeddings.py defaults to text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small
# Optional: override the list price used for the cost estimate (USD per 1M tokens).
# EMBEDDING_PRICE_PER_1M_TOKENS=0.02
